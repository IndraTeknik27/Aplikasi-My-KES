<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration.

  Allows cleartext HTTP traffic only to the local Laravel dev domain
  (karteks-energy-solution.test). Production domains should always be HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">karteks-energy-solution.test</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
